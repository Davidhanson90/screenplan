{
  "name": "screenplan",
  "version": "1.0.0",
  "description": "Modern multi-film Cineworld planner — pick a cinema, compare screenings, and generate conflict-free itineraries.",
  "type": "module",
  "private": true,
  "scripts": {
    "start": "vite",
    "dev": "vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:check": "tsc -p tsconfig.json --noEmit",
    "build:verify": "npm run test && npm run lint && npm run build && npm run test:check",
    "api:install": "npm --prefix api install",
    "api:dev": "npm --prefix api run dev",
    "api:build": "npm --prefix api run build",
    "api:start": "npm --prefix api run start",
    "data:refresh": "tsx scripts/refresh-data.ts",
    "data:demo": "tsx scripts/generate-demo-data.ts",
    "verify": "npm run build:verify && npm run api:build && npm --prefix api test"
  },
  "keywords": [
    "cineworld",
    "cinema",
    "planner",
    "itinerary",
    "lit",
    "vite",
    "typescript"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Davidhanson90/screenplan.git"
  },
  "bugs": {
    "url": "https://github.com/Davidhanson90/screenplan/issues"
  },
  "homepage": "https://davidhanson90.github.io/screenplan/",
  "author": "David Graville",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "lit": "^3.3.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.21.0",
    "@types/node": "^25.3.5",
    "@typescript-eslint/eslint-plugin": "^8.26.1",
    "@typescript-eslint/parser": "^8.26.1",
    "eslint": "^9.21.0",
    "eslint-plugin-import": "^2.31.0",
    "globals": "^16.0.0",
    "jsdom": "^26.0.0",
    "tsx": "^4.19.3",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vitest": "^4.0.18"
  }
}
